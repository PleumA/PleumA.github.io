{
  "name": "schedule-generator",
  "version": "1.11.0",
  "description": "ระบบจัดตารางเวรอัตโนมัติ – Automatic Duty Schedule Generator",
  "scripts": {
    "build": "npx tailwindcss -i src/input.css -o dist/output.css --minify",
    "build:watch": "npx tailwindcss -i src/input.css -o dist/output.css --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "test": "node run-tests.js"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0"
  }
}
